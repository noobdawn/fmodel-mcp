<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>aclprobe</AssemblyName>
    <RootNamespace>AclProbe</RootNamespace>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CUE4Parse source location — override with: dotnet build -p:CUE4ParseRoot=D:\path\to\CUE4Parse -->
    <CUE4ParseRoot Condition="'$(CUE4ParseRoot)' == ''">$(MSBuildThisFileDirectory)..\..\FModel\CUE4Parse</CUE4ParseRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseRoot)\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseRoot)\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
