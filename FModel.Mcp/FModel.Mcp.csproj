<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FModel.Mcp</RootNamespace>
    <AssemblyName>fmodel-mcp</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CUE4Parse 自带大量 nullable 告警，不让它们淹没本项目的 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CUE4Parse source location — override with: dotnet build -p:CUE4ParseRoot=D:\path\to\CUE4Parse -->
    <CUE4ParseRoot Condition="'$(CUE4ParseRoot)' == ''">$(MSBuildThisFileDirectory)..\FModel\CUE4Parse</CUE4ParseRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseRoot)\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseRoot)\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
